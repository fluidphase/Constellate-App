rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
      match /themes/{t} { allow read, write: if request.auth.uid == u; }
    }
    match /emojis/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    match /chats/{c} {
      allow read, update: if request.auth.uid in resource.data.members;
      allow create: if request.auth.uid in request.resource.data.members;
      match /messages/{m} {
        allow read, update: if request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members;
        allow create: if request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members
                      && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
